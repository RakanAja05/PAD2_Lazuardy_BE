APP_NAME=Lazuardy
APP_ENV=production
APP_KEY=                        # isi hasil: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://IP_VPS_KAMU:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error               # ganti dari debug ke error di production

DB_CONNECTION=mysql
DB_HOST=db                    # nama service docker-compose
DB_PORT=3306
DB_DATABASE=lazuardi_dev
DB_USERNAME=root
DB_PASSWORD=ISI_PASSWORD_KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=IP_VPS_KAMU

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

FRONTEND_URL=http://IP_FRONTEND_ATAU_DOMAIN

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ISI_EMAIL
MAIL_PASSWORD=ISI_APP_PASSWORD_GMAIL
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ISI_EMAIL
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=ISI_CLIENT_ID
GOOGLE_CLIENT_SECRET=ISI_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://IP_VPS_KAMU:8000/auth/google/callback

XENDIT_SECRET_KEY=ISI_SECRET_KEY
XENDIT_CALLBACK_TOKEN=ISI_CALLBACK_TOKEN

L5_SWAGGER_BASE_PATH=/api
L5_SWAGGER_GENERATE_ALWAYS=false   # matikan di production, boros resource
