APP_NAME=Lazuardy
APP_ENV=local
APP_KEY=                          # jalankan: php artisan key:generate --show
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=4                  # lebih cepat untuk development

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                  # ubah ke debug agar mempermudah pelacakan error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1                # gunakan localhost jika menjalankan DB secara lokal
DB_PORT=3306
DB_DATABASE=lazuardi_dev
DB_USERNAME=root
DB_PASSWORD=                     # isi sesuai konfigurasi lokal Anda

SESSION_DRIVER=file              # lebih simpel untuk development
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file                 # gunakan file atau array untuk development

FRONTEND_URL=http://localhost:3000

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log                  # gunakan log agar email hanya muncul di file laravel.log (aman)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=ISI_CLIENT_ID
GOOGLE_CLIENT_SECRET=ISI_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

XENDIT_SECRET_KEY=ISI_SECRET_KEY
XENDIT_CALLBACK_TOKEN=ISI_CALLBACK_TOKEN

L5_SWAGGER_BASE_PATH=/api
L5_SWAGGER_GENERATE_ALWAYS=true  # aktifkan agar dokumentasi selalu terupdate otomatis
