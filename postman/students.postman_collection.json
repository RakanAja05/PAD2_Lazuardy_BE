{
  "info": {
    "name": "PAD2 Lazuardy - Students (Profile & Review)",
    "description": "Collection untuk mengetes endpoint student profile & review.\n\nCara pakai:\n- Set variable `baseUrl` (contoh: http://localhost:8000)\n- Jalankan request `POST /api/login (Student)` untuk mengisi `studentToken`\n- Jalankan `GET /api/student/review` untuk mengisi `tutorId` otomatis (kalau ada data)\n- Jalankan `GET /api/student/review/{{tutorId}}` untuk mengisi `reviewId` (kalau review sudah ada)\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "studentEmail",
      "value": "student@example.test"
    },
    {
      "key": "studentPassword",
      "value": "password"
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "tutorId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/login (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('JSON response', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('status=success', function () { pm.expect(body.status).to.eql('success'); });",
                  "pm.test('token exists', function () { pm.expect(body.data).to.have.property('token'); });",
                  "pm.collectionVariables.set('studentToken', body.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "GET /api/me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Updated\",\n  \"gender\": \"male\",\n  \"date_of_birth\": \"2005-01-15\",\n  \"profile_photo_path\": \"uploads/dummy.jpg\",\n  \"address\": {\n    \"province\": \"Jawa Timur\",\n    \"regency\": \"Surabaya\",\n    \"district\": \"Gubeng\",\n    \"subdistrict\": \"Airlangga\",\n    \"street\": \"Jl. Airlangga No. 10\"\n  },\n  \"class_name\": \"Kelas 1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          }
        },
        {
          "name": "GET /api/student/review",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "student",
                "review"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('JSON response', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "if (body && Array.isArray(body.data) && body.data.length > 0 && body.data[0].tutor_id) {",
                  "  pm.collectionVariables.set('tutorId', body.data[0].tutor_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/student/review/{{tutorId}}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/review/{{tutorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "student",
                "review",
                "{{tutorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JSON response', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.id) {",
                  "  pm.collectionVariables.set('reviewId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/student/review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tutor_id\": {{tutorId}},\n  \"rate\": 5,\n  \"comment\": \"Mantap\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/student/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "student",
                "review"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/student/review",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tutor_id\": {{tutorId}},\n  \"rate\": 5,\n  \"comment\": \"Update review\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/student/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "student",
                "review"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/reviews/{{reviewId}}",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rate\": 4,\n  \"comment\": \"Update via /reviews/{id}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews/{{reviewId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reviews",
                "{{reviewId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
