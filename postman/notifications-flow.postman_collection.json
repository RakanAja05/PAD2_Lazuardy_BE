{
  "info": {
    "_postman_id": "b2e3e4d5-2a3a-4a9e-a6c0-0c4d6c4f0b7a",
    "name": "PAD2 Lazuardy - Notifications Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Notifications (Student)",
      "item": [
        {
          "name": "Login (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{student_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('student_auth_token', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "// Try to pick the first notification id for follow-up requests",
                  "if (json && json.data && json.data.notifications && json.data.notifications.length > 0) {",
                  "  var first = json.data.notifications[0];",
                  "  if (first && first.id) {",
                  "    pm.collectionVariables.set('notification_id', first.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Unread Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/unread-count",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications",
                "unread-count"
              ]
            }
          }
        },
        {
          "name": "Mark As Read (first notification)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/{{notification_id}}/read",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications",
                "{{notification_id}}",
                "read"
              ]
            }
          }
        },
        {
          "name": "Mark All As Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/read-all",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications",
                "read-all"
              ]
            }
          }
        },
        {
          "name": "Delete One (first notification)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/{{notification_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications",
                "{{notification_id}}"
              ]
            }
          }
        },
        {
          "name": "Delete All Read",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/read-all",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications",
                "read-all"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "student_email",
      "value": "student@example.test"
    },
    {
      "key": "student_password",
      "value": "password"
    },
    {
      "key": "student_auth_token",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    }
  ]
}
