{
  "info": {
    "name": "PAD2 Lazuardy - Admin",
    "description": "Collection untuk mengetes endpoint admin (tutor verification, student payment, analytics).\n\nCara pakai:\n- Set variable `baseUrl` (contoh: http://localhost:8000)\n- Jalankan request login untuk mengisi `adminToken`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.test"
    },
    {
      "key": "adminPassword",
      "value": "password"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "pendingTutorUserId",
      "value": "8"
    },
    {
      "key": "paymentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('JSON response', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('status=success', function () { pm.expect(body.status).to.eql('success'); });",
                  "pm.test('token exists', function () { pm.expect(body.data).to.have.property('token'); });",
                  "pm.collectionVariables.set('adminToken', body.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tutor Verification",
      "item": [
        {
          "name": "GET /api/admin/tutor/verify",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tutor/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "tutor",
                "verify"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/admin/tutor/{{pendingTutorUserId}}/verify/approve",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tutor/{{pendingTutorUserId}}/verify/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "tutor",
                "{{pendingTutorUserId}}",
                "verify",
                "approve"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/admin/tutor/{{pendingTutorUserId}}/verify/reject",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Dokumen belum lengkap\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/tutor/{{pendingTutorUserId}}/verify/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "tutor",
                "{{pendingTutorUserId}}",
                "verify",
                "reject"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Student Payments",
      "item": [
        {
          "name": "GET /api/admin/student",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/student",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "student"
              ]
            }
          }
        },
        {
          "name": "GET /api/admin/student/{{paymentId}}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/student/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "student",
                "{{paymentId}}"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/admin/student/{{paymentId}}/accept",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/student/{{paymentId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "student",
                "{{paymentId}}",
                "accept"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/admin/student/{{paymentId}}/reject",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/student/{{paymentId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "student",
                "{{paymentId}}",
                "reject"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "GET /api/admin/analytic",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/analytic",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "analytic"
              ]
            }
          }
        }
      ]
    }
  ]
}
